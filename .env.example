# -------------------------------------------------------------
# Simfly Store â€” WhatsApp eSIM bot (.env.example)
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# `.env` is git-ignored â€” real credentials never get committed.
# Every variable below is optional unless marked REQUIRED.
# -------------------------------------------------------------

# ---------------- BRAND ---------------------------------------
# The ONE brand name â€” menus, titles, cards, admin panel, dashboard.
BRAND_NAME=Simfly Store
# Tagline shown under the brand name.
BRAND_TAGLINE=Aapki Digital Zaroorat, Ek Store Mein
# The footer watermark on EVERY list / button message is derived
# automatically from the two vars above: "{BRAND_NAME} âš¡ {BRAND_TAGLINE}"
# (BOT_DISPLAY_NAME and FOOTER_TEXT are no longer read.)

# ---------------- ADMIN (REQUIRED FOR THE ORDER FLOW) ----------
# Your personal WhatsApp number that receives order screenshots
# and handles `confirm` / `reject` / `status` commands.
# Accepts: 03001234567 | 923001234567 | 923001234567@s.whatsapp.net
ADMIN_WHATSAPP_NUMBER=03001234567

# â”€â”€ Admin system (in-WhatsApp admin panel) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Extra OWNER numbers (comma-separated, same formats as above).
# ADMIN_WHATSAPP_NUMBER stays the primary owner.
ADMIN_NUMBERS=
# STAFF numbers: can open the panel, confirm/reject orders and
# use Find/Stats â€” but NOT Settings, price edits or broadcasts.
STAFF_NUMBERS=
# Orders priced at/above this (PKR) need a SECOND confirm tap
# (double-confirm screen) before the supplier is charged.
CONFIRM_TWICE_ABOVE_PKR=3000
# ðŸ“¢ Broadcast throttle â€” keep these LOW. This bot messages
# customers over an UNOFFICIAL WhatsApp route: blast too fast and
# the number gets banned. Preview shows the ETA before you send.
BROADCAST_MSGS_PER_MINUTE=8
BROADCAST_DAILY_CAP=200
# Random extra delay between two DMs: "3000-9000" = 3â€“9 seconds.
BROADCAST_JITTER_MS=3000-9000
# ðŸŒ Web dashboard. Two options:
#   Bundled (recommended): set DASHBOARD_PORT + DASHBOARD_TOKEN and
#     open http://localhost:<DASHBOARD_PORT>/?token=<DASHBOARD_TOKEN>
#   External: set DASHBOARD_URL to your own dashboard and the panel's
#     Dashboard row opens that URL instead.
DASHBOARD_PORT=
DASHBOARD_TOKEN=
DASHBOARD_URL=
# ðŸª WhatsApp Business Catalog (dashboard â†’ WhatsApp Catalog tab).
#   Local truth: catalog/products/<retailerId>/product.json + image.jpg,
#   sync state:  catalog/catalog.json (retailerId â†’ WhatsApp product id).
#   Seed once:   node scripts/seedCatalog.js
# CATALOG_DIR=catalog
# CATALOG_INDEX_FILE=catalog/catalog.json
# Pause between two WA catalogue mutations (rate limit) + products per sync run.
CATALOG_SYNC_DELAY_MS=300
CATALOG_SYNC_BATCH=100
# Low-balance warning threshold for the supplier account (USD).
SUPPLIER_LOW_BALANCE_USD=10
# Daily / weekly admin summary messages (cron, Asia/Karachi).
DAILY_SUMMARY_CRON=0 21 * * *
WEEKLY_SUMMARY_CRON=0 9 * * 1

# ---------------- SUPPORT CONTACT ------------------------------
# Number customers are pointed to for "Talk to Support".
# Leave empty to reuse ADMIN_WHATSAPP_NUMBER.
SUPPORT_WHATSAPP_NUMBER=

# ---------------- eSIM SUPPLIER (eSIMaccess.com) ----------------
# From your eSIMaccess dashboard -> API / Developer section.
# With these set, `confirm SMF-XXXX` purchases the eSIM from the
# supplier automatically and the bot sends the real QR/activation.
# Leave empty to run in MANUAL mode (local catalogue + delivery
# payloads from data/deliveries.json) â€” the bot still works.
ESIMACCESS_API_KEY=
ESIMACCESS_API_SECRET=
ESIMACCESS_BASE_URL=https://api.esimaccess.com
# Optional: HTTP timeout for supplier calls (milliseconds).
ESIMACCESS_TIMEOUT_MS=15000

# ---------------- CHECKOUT (TWO STEPS) --------------------------
# Step 1 "Choose & Confirm" (device check + quantity) -> Step 2 "Pay".
# Max eSIMs one customer can put on ONE order. Every unit is purchased
# separately and delivered as its own QR/activation code.
# Default 3, minimum 1.
MAX_QTY_ESIM=3

# ---------------- PAYMENT ACCOUNT DETAILS ----------------------
# Shown to the customer instantly after they pick a method.
# Leave a value empty to hide that method from the menu.
# ONLY the methods you fill in appear â€” currently: SadaPay,
# Binance ID and (with BINANCE_PAY_ID) Binance Pay.

# SadaPay (account number + account title)
PAYMENT_SADAPAY_NUMBER=
PAYMENT_SADAPAY_TITLE=

# Binance (your Binance ID + the coin/network customers pay on)
PAYMENT_BINANCE_ID=
PAYMENT_BINANCE_NETWORK=USDT (TRC20)

# â”€â”€ Legacy methods (still supported â€” fill them in only if you
#    want them back in the payment list) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# JazzCash
PAYMENT_JAZZCASH_NUMBER=
PAYMENT_JAZZCASH_TITLE=

# Easypaisa
PAYMENT_EASYPAISA_NUMBER=
PAYMENT_EASYPAISA_TITLE=

# Bank Transfer â€” one free-form block, shown to the customer
# exactly as written (use \n for line breaks).
PAYMENT_BANK_DETAILS=

# ---------------- BINANCE PAY (USDT AUTO-VERIFICATION) ----------
# ðŸ’³ A SEPARATE method from PAYMENT_BINANCE_ID above: instead of a
# screenshot the customer is shown a USDT amount + our Binance Pay
# ID and simply TYPES their Transaction ID. The bot then looks that
# ID up on Binance and matches amount + time window.
#
# Setup (personal Binance account, ~2 minutes):
#   1. Binance â†’ Account â†’ API Management â†’ Create API
#      â€¢ type: System-generated (HMAC)
#      â€¢ permission: READ-ONLY only â€” no Enable Withdrawals, no
#        Enable Trading. Keep IP restrictions if you have a static IP.
#   2. Binance â†’ Pay â†’ Profile â†’ copy your Binance Pay ID into
#      BINANCE_PAY_ID (this is the ID customers pay TO).
#
# The key/secret are ONLY used to sign GET /sapi/v1/pay/transactions
# and only ever leave the process inside the X-MBX-APIKEY header +
# the query signature. They are git-ignored with the rest of .env and
# are MASKED everywhere they are displayed (admin panel, dashboard).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PAY_ID=
# Optional overrides:
#   BINANCE_BASE_URL        default https://api.binance.com
#   BINANCE_TIMEOUT_MS      default 15000
#   BINANCE_TX_FILE         default <DB_DIR>/binanceTransactions.json
# PKR per USDT (defaults to USD_PKR_RATE â€” set it if USDT trades
# away from the dollar).
USDT_PKR_RATE=
# A transaction may sit this many minutes either side of the order
# and still count as a match (default 60).
BINANCE_MATCH_WINDOW_MIN=60
# Retry loop: look again every 20s for up to 5 minutes.
BINANCE_RETRY_MS=20000
BINANCE_MAX_WAIT_MS=300000
# Rollout â€” start in shadow and promote to auto once you trust it:
#   off     â†’ never call the API, every order goes to the admin
#   shadow  â†’ look it up, log/report the verdict, still admin-confirmed
#   auto    â†’ a clean match (id + amount + currency + time) fulfils
#             the order by itself; anything doubtful still falls
#             through to the admin card
BINANCE_VERIFIER_MODE=shadow

# ðŸ’³ Auto-verifier is NOT an env var â€” change it in WhatsApp:
#   admin panel â†’ Settings â†’ Auto-verifier (off / shadow / on).
#   off = manual confirm Â· shadow = only report matches Â·
#   on = confirmed payments are verified automatically.

# ---------------- AI PAYMENT DECISION ENGINE (PART B) -----------
# The analyst sits ON TOP of the verifiers above: deterministic code
# always decides first, a model is consulted only when code says
# "I cannot tell" (no_match / time_window), and its answer is
# re-checked against the invariants before anything happens.
# Defaults (leave unset to start): shadow + 8000ms.
#
#   off     â†’ never call a model, never write a decision record
#   shadow  â†’ call + report on the admin card, never change an outcome
#   auto    â†’ may act, but ONLY when every invariant holds
# Never "off" â‡’ the bot behaves exactly as it did before.
AI_VERIFIER_MODE=shadow
# Give up on a slow model and hand the order to the admin (ms).
AI_DECISION_TIMEOUT_MS=8000

# The analyst: one low-temperature JSON verdict per ambiguous payment.
# https://console.groq.com/keys  (free tier is plenty â€” this is ONE
# short call per doubtful payment, not per order).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Vision: reads the payment screenshot (amount / txn id / date) so the
# analyst has real evidence instead of a filename. Without this key the
# engine carries NO screenshot evidence and the deterministic check
# runs exactly as before â€” there is no offline OCR fallback.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional overrides:
#   GROQ_BASE_URL     default https://api.groq.com/openai/v1
#   GEMINI_BASE_URL   default https://generativelanguage.googleapis.com/v1beta
#   AI_DECISIONS_FILE default <DB_DIR>/aiDecisions.json (last 500 verdicts)

# ---------------- PURPLE COW LAYER (PART C) ---------------------
# âš¡ Fast Guarantee: the promise you make in public. Delivery inside
#    this many minutes of `confirm` gets a badge on the delivery
#    message; past it the bot CREDITS THE WALLET automatically â€”
#    no support chat, no form, no asking. 0 credit = badge only.
FAST_GUARANTEE_MINUTES=15
FAST_GUARANTEE_CREDIT_PKR=100

# ðŸ“¦ Digital Unboxing: the 3-beat "it landed" sequence that runs
#    (human-paced) before the thank-you. on | off
UNBOXING_MODE=on

# ðŸŽ Referral loop: every customer gets a stable invite code; a NEW
#    customer who types it gets this much, and so does the referrer
#    (same wallet ledger as everything else).
#    Guards: one credit per new phone Â· no self-referral Â·
#    REFERRAL_MONTHLY_CAP PKR of bonuses per referrer per month.
REFERRAL_BONUS_PKR=100
REFERRAL_MONTHLY_CAP=1000
# Optional: where the referral share message points (defaults to ORDER_LINK).

# ---------------- SECOND CATALOGUE: DIGITAL STORE --------------
# ProdSeller (prodseller.com) sells digital products â€” gift cards,
# subscriptions, VPN, email-activation accounts â€” as a SEPARATE
# store from the eSIM catalogue (ðŸ›ï¸ Digital Store in the menu).
# Get the key at prodseller.com â†’ API Keys. Without it the store
# stays hidden; eSIM sales keep working.
PRODSELLER_API_KEY=
PRODSELLER_BASE_URL=https://prodseller.com/v1
# Pricing â€” NOTHING is hardcoded, every price is computed live:
#   sell PKR = USD price Ã— USD_PKR_RATE Ã— (1 + DIGITAL_MARKUP_PERCENT%)
# All three inputs can be overridden from the admin panel WITHOUT
# touching this file: per-product USD price (âœï¸ USD price), live
# PKR/USD rate (ðŸ’µ USD Rate) and global/per-product ROI (âœï¸ Markup).
# The USD figure is NEVER shown to a customer.
USD_PKR_RATE=278
DIGITAL_MARKUP_PERCENT=50
# A product you PIN (ðŸ“Œ Price pin) keeps its PKR price until your
# effective markup falls below this floor % â€” then the formula
# above takes over again. Set 0 to disable price pins.
PINNED_MARKUP_FLOOR=50
# How long the catalogue is cached (seconds) â€” keeps the 300
# requests / 15 minutes ProdSeller rate limit comfortable.
PRODSELLER_CACHE_SECONDS=120
# Email-activation products are NOT instant: the customer is told
# activation ETA (this label) before they pay.
ACTIVATION_ETA_LABEL=usually within 2-6 hours
# How often the bot re-checks an awaiting-activation order, and
# when it gives up and pages the owner.
ACTIVATION_POLL_MINUTES=2
ACTIVATION_MAX_WAIT_HOURS=6
# Warn (admin alert) when the ProdSeller USDT balance drops here.
PRODSELLER_LOW_BALANCE_USD=15
# Daily supplier sync: force-refreshes the catalogue, then pages
# the admins with a cost/stock diff + balance line. First run after
# install is quiet (it only seeds the baseline). 24h-ish pattern.
PRICE_SYNC_ENABLED=true
PRICE_SYNC_CRON=0 6 * * *

# ---------------- SECOND DIGITAL SUPPLIER: EKLAS ---------------
# api.eklas.dev (docs.eklas.dev) â€” the store automatically sources
# each product from whichever supplier (ProdSeller OR Eklas) is
# cheaper AND in stock, falling back to the other if the winner runs
# out. Customers never see supplier names; prices stay in PKR.
# Every Eklas product is listed too: one that shares a name with a
# product already on the shelf is merged into that row (shown once),
# a unique one gets its own row (id "eklas:<sku>").
# Auth style is DIFFERENT from ProdSeller â€” do not mix them up:
#   ProdSeller â†’ X-API-Key header     Eklas â†’ Authorization: Bearer <key>
# Leave blank to run single-supplier (ProdSeller only).
EKLAS_API_KEY=
EKLAS_BASE_URL=https://api.eklas.dev/v1
# Optional: HTTP timeout for Eklas calls (milliseconds).
EKLAS_TIMEOUT_MS=15000
# Eklas wallet low-balance threshold (USDT) â€” its own alert, kept
# separate from PRODSELLER_LOW_BALANCE_USD.
EKLAS_LOW_BALANCE_USD=15
# How long the "cheapest + in stock" comparison is cached (seconds).
PRODUCT_COMPARE_CACHE_SECONDS=120
# The ONE Simfly product â†’ ProdSeller ID / Eklas ID mapping is
# hand-maintained (dashboard or WhatsApp admin) at
# data/productSupplierMap.json â€” never fuzzy name-matched.

# ---------------- CUSTOMER WALLET --------------------------------
# Prepaid PKR balance: customers top up ONCE (verified at top-up),
# then pay for BOTH eSIM plans and Digital products in one tap â€”
# no screenshot at purchase time. Separate from the eSIMaccess
# supplier balance, with its own admin alerts.
WALLET_ENABLED=true
# Top-up limits (PKR) + anti-abuse rate limit per customer.
WALLET_TOPUP_MIN=100
WALLET_TOPUP_MAX=20000
WALLET_TOPUP_MAX_ATTEMPTS=5
WALLET_TOPUP_WINDOW_MS=600000

# ---------------- WHATSAPP CHANNEL + ORDER LINK -----------------
# Your WhatsApp Channel invite link â€” shown to customers after
# each completed order since the bot number may change.
# (Put your actual channel link here when you go live.)
WHATSAPP_CHANNEL_LINK=
# Optional: direct channel JID, e.g. 120363000000000000@newsletter.
# Leave empty - the bot resolves it from WHATSAPP_CHANNEL_LINK.
# A bare invite code (the part after /channel/) also works here.
WHATSAPP_CHANNEL_JID=
# Link shown in the "Order now" CTA of auto-posted reviews
# (your bot's wa.me chat link or a landing page).
ORDER_LINK=

# ---------------- BEHAVIOUR ------------------------------------
# Minutes without admin action before the bot messages the
# customer "still processing" AND pings the admin. Default: 15
AUTO_REMINDER_MINUTES=15

# Minutes after an eSIM is delivered before the customer is
# asked for a â­ review (their next message also triggers it).
REVIEW_DELAY_MINUTES=2

# Anti-spam: max messages a single user may send inside the
# window below before being throttled.
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000

# Anti-spam: minimum gap (ms) between two MENU triggers.
MENU_COOLDOWN_MS=5000

# Force every list / button to render as a numbered plain-text
# menu (use for very old WhatsApp clients).
# true | false
FORCE_PLAIN_TEXT=false

# â”€â”€ Natural pacing (bot maturity) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Every reply waits a length-proportional delay (base + ~35ms per
# word) clamped to [MIN, MAX] with Â±200ms of jitter, while the
# customer sees a "typingâ€¦" indicator. Multi-message replies to the
# same chat are spaced out instead of fired back-to-back.
MIN_REPLY_DELAY_MS=700
MAX_REPLY_DELAY_MS=2800
# Messages from one customer inside this window are buffered and
# processed as ONE input (people type across bubbles).
DEBOUNCE_WINDOW_MS=1500
# An unanswered star-rating prompt is quietly dropped after this
# many hours â€” never re-sent.
REVIEW_PROMPT_TIMEOUT_HOURS=6
# Minimum gap between two automated (non-critical) messages to the
# same customer; lower-priority notices are queued and batched.
BROADCAST_MIN_GAP_MINUTES=30

# â”€â”€ Post-order engagement (UX batch) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Every Nth delivered order unlocks a one-time discount code.
LOYALTY_ORDERS=5
# Percent off for the loyalty reward code.
LOYALTY_DISCOUNT_PERCENT=10
# An interrupted order stays resumable ("Continue?") this long.
SESSION_TTL_HOURS=24
# After "Talk to Human" the bot stays quiet on free text this
# long (admin can end it early with: bot on <number>).
HUMAN_MODE_MINUTES=30
# How long the bulk stock check is cached (seconds) so plan
# lists + payment steps don't hammer the supplier.
STOCK_CACHE_SECONDS=60
# node-cron expression for the restock / price-drop watcher.
ALERTS_CRON=*/15 * * * *
# Auto-verify payments (stub for a future NayaPay integration).
# true | false
NAYAPAY_AUTO_VERIFY=false

# ---------------- PATHS (rarely changed) ------------------------
# Where the QR login session is persisted between restarts.
AUTH_DIR=auth_info
# Where plan + delivery JSON files live.
DATA_DIR=data
# Where the order store (lowdb) lives.
DB_DIR=db
# Order store file override (defaults to <DB_DIR>/orders.json).
STORE_FILE=
# Review store file override (defaults to <DB_DIR>/reviews.json).
REVIEWS_FILE=
# Resume-session / profile / alert-subscription overrides
# (defaults to <DB_DIR>/sessions.json, users.json, alerts.json).
SESSIONS_FILE=
USERS_FILE=
ALERTS_FILE=
# Admin-system file overrides (defaults to <DB_DIR>/audit.json,
# admin.json, payments.json, broadcast.json, binanceTransactions.json).
AUDIT_FILE=
ADMIN_STATE_FILE=
PAYMENTS_FILE=
BROADCAST_FILE=
BINANCE_TX_FILE=
# Digital Store + Wallet file overrides (defaults:
#   data/digitalProductOverrides.json, data/sales.json,
#   <DB_DIR>/digitalOrderPolls.json, <DB_DIR>/wallets.json,
#   <DB_DIR>/walletTransactions.json, <DB_DIR>/priceSync.json).
DIGITAL_OVERRIDES_FILE=
DIGITAL_POLLS_FILE=
SALES_FILE=
PRICE_SYNC_FILE=
WALLETS_FILE=
WALLET_TX_FILE=
# Where pino writes the application log.
LOG_DIR=logs
